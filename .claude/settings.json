{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "NG_CLI_ANALYTICS": "false"
  },
  "permissions": {
    "allow": [
      "Edit(./src/**)",
      "Bash(ng build)",
      "Bash(ng build *)",
      "Bash(ng test)",
      "Bash(ng test *)",
      "Bash(ng lint)",
      "Bash(ng lint *)",
      "Bash(ng generate *)",
      "Bash(ng g *)",
      "Bash(npx ng build *)",
      "Bash(npx ng test *)",
      "Bash(npx ng lint *)",
      "Bash(npx ng generate *)",
      "Bash(npx ng g *)",
      "Bash(npx tsc *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npm run build)",
      "Bash(npm run test:ci)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run typecheck)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run verify)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "mcp__angular-cli"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(ng add *)",
      "Bash(npx ng add *)",
      "Bash(ng update *)",
      "Bash(npx ng update *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-lint.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
